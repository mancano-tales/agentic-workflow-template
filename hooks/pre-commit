#!/usr/bin/env bash
# ==============================================================================
# pre-commit — Git Hook para Validação Automática de Governança
# ==============================================================================

# T-WIN-PATH: Localiza Rscript no Windows ou Unix
RSCRIPT_BIN="Rscript"
if ! command -v Rscript &> /dev/null; then
  if [ -f "/c/Program Files/R/R-4.4.1/bin/Rscript.exe" ]; then
    RSCRIPT_BIN="/c/Program Files/R/R-4.4.1/bin/Rscript.exe"
  elif [ -f "/c/Program Files/R/R-4.4.0/bin/Rscript.exe" ]; then
    RSCRIPT_BIN="/c/Program Files/R/R-4.4.0/bin/Rscript.exe"
  fi
fi

"$RSCRIPT_BIN" tools/validate-governance.R --hook
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo "======================================================================"
  echo " [ERRO FATAL PRE-COMMIT] Auditoria de governança falhou."
  echo " Corrija as inconsistências listadas acima antes de commitar."
  echo "======================================================================"
  exit 1
fi

exit 0
