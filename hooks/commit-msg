#!/usr/bin/env bash
# ==============================================================================
# commit-msg — Validador de Mensagem de Commit (Conventional Commits 1.0.0)
# ==============================================================================

COMMIT_MSG_FILE="$1"

if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
  exit 0
fi

# T-HOOK-BYPASS: Dispensa validação em merges
FIRST_LINE=$(head -n 1 "$COMMIT_MSG_FILE")

if [[ "$FIRST_LINE" =~ ^Merge ]]; then
  exit 0
fi

if [[ "$FIRST_LINE" =~ ^Revert ]]; then
  exit 0
fi

# T-REGEX-SCOPE: Aceita padrão Conventional Commits com escopo opcional
# Ex: feat(core): add new feature ou docs: update readme
PATTERN="^(thesis|lit|data|draft|docs|build|ci|chore|feat|fix|refactor)(\([a-zA-Z0-9_-]+\))?!?: .+$"

if [[ ! "$FIRST_LINE" =~ $PATTERN ]]; then
  echo "======================================================================"
  echo " [ERRO] MENSAGEM DE COMMIT FORA DO PADRÃO CONVENTIONAL COMMITS"
  echo "======================================================================"
  echo " Sua mensagem: '$FIRST_LINE'"
  echo ""
  echo " Formato exigido: <tipo>(<escopo>): <descrição>"
  echo " Tipos aceitos: thesis, lit, data, draft, docs, build, ci, chore, feat, fix, refactor"
  echo " Exemplo: feat(core): add new validation rule"
  echo "======================================================================"
  exit 1
fi

exit 0
